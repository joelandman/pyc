build/
build_debug/
/pyc
build_asan/

# root-level artifacts from direct `pyc` runs (a.out, objects, IR dumps, debug helpers)
a.out
a.out.*
*.o
*.ll
*.s
*_dbg.py
*.dbg.py
# B7 module-registry C source generated alongside every compiled binary
*_b7_modules.c

# Python bytecode caches (created by Python3 imports during build/test)
__pycache__/
*.pyc

# compiled test binaries and their LTO bitcode (e.g. tests/nb8.exe, nb8.exe.bc);
# the companion .o and _b7_modules.c are covered by the patterns above
*.exe
*.exe.bc
